@startuml casos-uso
' Diagrama de casos de uso de las consultas de sql/consultas.
' Se excluye control/control-carga-datos.sql: verifica la precarga de la base
' y no corresponde a ningún rol de USUARIO.

skin rose
left to right direction
skinparam ranksep 220

<style>
rectangle {
  HorizontalAlignment center
}
</style>

actor Cliente
actor Vendedor
actor Administrador

rectangle "Sistema de venta de libros" {
  ' cliente/
  usecase "Consultar ofertas vigentes\npor libro" as UC_OFERTAS
  usecase "Consultar comprobante\nde venta" as UC_COMPROBANTE
  usecase "Consultar pedidos\ndel cliente" as UC_PEDIDOS_CLIENTE
  usecase "Consultar direcciones\ndel cliente" as UC_DIRECCIONES
  usecase "Buscar libros\nen el catálogo" as UC_BUSCAR

  ' vendedor/
  usecase "Consultar publicaciones\ndel vendedor" as UC_PUBLICACIONES
  usecase "Consultar pedidos\na entregar" as UC_A_ENTREGAR
  usecase "Consultar ventas\npor publicación" as UC_VENTAS_PUBLICACION

  ' vendedor-administrador/
  usecase "Consultar total de ventas\npor categoría" as UC_VENTAS_CATEGORIA
  usecase "Consultar ventas\npor mes" as UC_VENTAS_MES
  usecase "Consultar libros\nmás vendidos" as UC_MAS_VENDIDOS

  ' administrador/
  usecase "Consultar total de ventas\npor vendedor" as UC_VENTAS_VENDEDOR
  usecase "Consultar pedidos\ncon pago aprobado" as UC_CON_PAGO
  usecase "Consultar pedidos\nsin pago aprobado" as UC_SIN_PAGO
  usecase "Consultar pagos\npor método" as UC_PAGOS_METODO
  usecase "Consultar usuarios\npor rol" as UC_USUARIOS
}

' Enlaces ocultos: mantienen los casos en una columna, agrupados por carpeta.
' Se escriben de abajo hacia arriba porque Graphviz invierte el orden dentro
' del rectángulo; así los casos se dibujan en el orden en que se declaran.
UC_USUARIOS -[hidden]right- UC_PAGOS_METODO
UC_PAGOS_METODO -[hidden]right- UC_SIN_PAGO
UC_SIN_PAGO -[hidden]right- UC_CON_PAGO
UC_CON_PAGO -[hidden]right- UC_VENTAS_VENDEDOR
UC_VENTAS_VENDEDOR -[hidden]right- UC_MAS_VENDIDOS
UC_MAS_VENDIDOS -[hidden]right- UC_VENTAS_MES
UC_VENTAS_MES -[hidden]right- UC_VENTAS_CATEGORIA
UC_VENTAS_CATEGORIA -[hidden]right- UC_VENTAS_PUBLICACION
UC_VENTAS_PUBLICACION -[hidden]right- UC_A_ENTREGAR
UC_A_ENTREGAR -[hidden]right- UC_PUBLICACIONES
UC_PUBLICACIONES -[hidden]right- UC_BUSCAR
UC_BUSCAR -[hidden]right- UC_DIRECCIONES
UC_DIRECCIONES -[hidden]right- UC_PEDIDOS_CLIENTE
UC_PEDIDOS_CLIENTE -[hidden]right- UC_COMPROBANTE
UC_COMPROBANTE -[hidden]right- UC_OFERTAS

Cliente --> UC_OFERTAS
Cliente --> UC_COMPROBANTE
Cliente --> UC_PEDIDOS_CLIENTE
Cliente --> UC_DIRECCIONES
Cliente --> UC_BUSCAR

Vendedor --> UC_BUSCAR
Vendedor --> UC_PUBLICACIONES
Vendedor --> UC_A_ENTREGAR
Vendedor --> UC_VENTAS_PUBLICACION
Vendedor --> UC_VENTAS_CATEGORIA
Vendedor --> UC_VENTAS_MES
Vendedor --> UC_MAS_VENDIDOS

' Con la flecha invertida, el Administrador queda a la derecha del sistema y
' sus líneas no se cruzan con las del Vendedor.
UC_VENTAS_CATEGORIA <-- Administrador
UC_VENTAS_MES <-- Administrador
UC_MAS_VENDIDOS <-- Administrador
UC_VENTAS_VENDEDOR <-- Administrador
UC_CON_PAGO <-- Administrador
UC_SIN_PAGO <-- Administrador
UC_PAGOS_METODO <-- Administrador
UC_USUARIOS <-- Administrador

@enduml
